# Pointly server — variáveis de ambiente (copie para `.env` se rodar fora do Docker).
# Nenhum valor aqui é real: placeholders vazios, preenchidos no deploy.

# Segredo do `GET /api/stats/visits` (consumido pelo ESP32).
# Envie como `Authorization: Bearer <token>` ou `X-Stats-Key: <token>`.
# Vazio → o endpoint responde 503 (fail closed). Nunca comitar um valor real.
STATS_API_TOKEN=

# Onde os contadores first-party por dia são persistidos (JSON).
# Default: data/visits.json relativo ao cwd.
VISITS_DATA_FILE=
