# Opcional: sobrescreve o endpoint do WebSocket.
# Padrão: em dev usa ws://<host>:3001/ws; em prod usa a mesma origem (/ws).
VITE_WS_URL=

# Opcional: base da API REST.
# Padrão: /api/v1 (o proxy do Vite encaminha para :3001 em dev).
VITE_API_BASE=

# Opcional: Google Analytics 4 Measurement ID (ex.: G-XXXXXXXX).
# Build-time (Vite inline). Vazio / ausente → analytics no-op (zero request).
# Em Docker: passe como build-arg VITE_GA_MEASUREMENT_ID (ver docker-compose + Dockerfile).
# Com ID definido, o script só carrega após consentimento explícito no banner.
# O ID é público e fica no bundle; deixe vazio para desativar analytics por completo.
VITE_GA_MEASUREMENT_ID=
