{
	"name": "pointly",
	"private": true,
	"type": "module",
	"description": "Pointly — Planning Poker web sem cadastro (monorepo Bun)",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev:web": "bun --filter pointly-web dev",
		"build:web": "bun --filter pointly-web build",
		"typecheck:web": "bun --filter pointly-web typecheck",
		"test:server": "bun --filter server test"
	}
}
